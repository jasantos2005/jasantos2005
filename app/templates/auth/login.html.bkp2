<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hub Gerencial — GSG</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0d0f12;
            color: #e8eaf0;
            font-family: 'DM Sans', sans-serif;
            display: flex;
            align-items: stretch;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

        /* Fundo animado sutil */
        body::before {
            content: '';
            position: fixed;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0,200,160,0.06) 0%, transparent 50%),
                        radial-gradient(ellipse at 70% 70%, rgba(99,102,241,0.06) 0%, transparent 50%);
            animation: bgPulse 8s ease-in-out infinite alternate;
        }
        @keyframes bgPulse {
            0%   { transform: scale(1) rotate(0deg); }
            100% { transform: scale(1.05) rotate(2deg); }
        }

        /* ── SPLIT LAYOUT ── */
        .lp-left {
            flex: 1.2;
            background: #0b1120;
            padding: 48px 44px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            min-width: 0;
            z-index: 1;
        }
        .lp-left::before {
            content: '';
            position: absolute;
            top: -120px; right: -120px;
            width: 400px; height: 400px;
            border-radius: 50%;
            background: rgba(0,200,160,.06);
            pointer-events: none;
        }
        .lp-left::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            border-radius: 50%;
            background: rgba(99,102,241,.05);
            pointer-events: none;
        }
        .lp-brand { display: flex; align-items: center; gap: 10px; position: relative; z-index: 1; }
        .lp-brand-icon { width: 38px; height: 38px; border-radius: 10px; background: #00c8a0; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .lp-brand-name { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 900; color: #fff; letter-spacing: -.5px; }
        .lp-brand-name span { color: #00c8a0; }
        .lp-hero { position: relative; z-index: 1; }
        .lp-hero-tag { display: inline-block; background: rgba(0,200,160,.1); border: 1px solid rgba(0,200,160,.2); color: #00c8a0; font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; padding: 4px 12px; border-radius: 20px; margin-bottom: 14px; }
        .lp-hero-title { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 900; color: #fff; line-height: 1.2; margin-bottom: 10px; letter-spacing: -.5px; }
        .lp-hero-title span { color: #00c8a0; }
        .lp-hero-sub { font-size: 13px; color: #6a7d9e; line-height: 1.65; max-width: 300px; }
        .lp-modules { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; position: relative; z-index: 1; }
        .lp-mod { background: rgba(255,255,255,.04); border: 0.5px solid rgba(255,255,255,.08); border-radius: 12px; padding: 14px 16px; transition: background .2s, border-color .2s; }
        .lp-mod:hover { background: rgba(255,255,255,.07); border-color: rgba(0,200,160,.2); }
        .lp-mod-icon { font-size: 18px; margin-bottom: 8px; }
        .lp-mod-name { font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 700; color: #fff; margin-bottom: 3px; }
        .lp-mod-desc { font-size: 11px; color: #4a5e7a; line-height: 1.4; }
        .lp-mod-badge { display: inline-block; margin-top: 6px; font-size: 10px; font-weight: 600; color: #00c8a0; background: rgba(0,200,160,.1); border-radius: 4px; padding: 2px 7px; }
        .lp-mod-badge.novo { color: #f5a623; background: rgba(245,166,35,.12); }
        .lp-right { flex: 1; display: flex; align-items: center; justify-content: center; padding: 48px 44px; min-width: 340px; max-width: 500px; position: relative; z-index: 1; }
        .login-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 400px;
        }

        /* Card de login */
        .login-card {
            background: #181c22;
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 20px;
            padding: 40px 36px 36px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        /* Logo / Header */
        .login-header {
            text-align: center;
            margin-bottom: 32px;
        }
        .login-logo {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #00c8a0, #009e7f);
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #fff;
            margin-bottom: 16px;
            box-shadow: 0 8px 24px rgba(0,200,160,0.3);
        }
        .login-title {
            font-family: 'Syne', sans-serif;
            font-size: 22px;
            font-weight: 800;
            color: #fff;
            letter-spacing: 0.5px;
            line-height: 1.2;
        }
        .login-subtitle {
            font-size: 12px;
            color: #6b7280;
            margin-top: 4px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 600;
        }

        /* Formulário */
        .form-group {
            margin-bottom: 14px;
        }
        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 6px;
        }
        .input-wrap {
            position: relative;
        }
        .input-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #4b5563;
            font-size: 13px;
        }
        .form-control {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            color: #e8eaf0;
            padding: 11px 14px 11px 38px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }
        .form-control:focus {
            border-color: rgba(0,200,160,0.4);
            background: rgba(0,200,160,0.04);
            box-shadow: 0 0 0 3px rgba(0,200,160,0.08);
        }
        .form-control::placeholder { color: #4b5563; }

        /* Botão */
        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, #00c8a0, #009e7f);
            color: #fff;
            border: none;
            padding: 13px;
            border-radius: 10px;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 1px;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.2s;
            box-shadow: 0 4px 16px rgba(0,200,160,0.25);
        }
        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(0,200,160,0.35);
        }
        .btn-login:active { transform: translateY(0); }

        /* Erro */
        .error-msg {
            background: rgba(240,82,82,0.1);
            border: 1px solid rgba(240,82,82,0.2);
            color: #f05252;
            font-size: 13px;
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Footer do card */
        .login-footer {
            text-align: center;
            margin-top: 24px;
            font-size: 11px;
            color: #374151;
        }
        .login-footer span {
            color: #4b5563;
        }
    </style>
</head>
<body>

  <!-- ESQUERDA: vitrine dos módulos -->
  <div class="lp-left">
    <div class="lp-brand">
      <div class="lp-brand-icon">&#9889;</div>
      <div class="lp-brand-name">Ia<span>Tech</span>Hub</div>
    </div>

    <div class="lp-hero">
      <div class="lp-hero-tag">Plataforma ISP</div>
      <div class="lp-hero-title">Tudo que seu<br>provedor <span>precisa</span></div>
      <div class="lp-hero-sub">Automações integradas ao IXC Soft para escalar vendas, operações e retenção de clientes.</div>
    </div>

    <div class="lp-modules">
      <div class="lp-mod">
        <div class="lp-mod-icon">&#128722;</div>
        <div class="lp-mod-name">Hub Comercial</div>
        <div class="lp-mod-desc">Vendas, auditoria automática e ativação no IXC</div>
        <div class="lp-mod-badge">Ativo</div>
      </div>
      <div class="lp-mod">
        <div class="lp-mod-icon">&#128295;</div>
        <div class="lp-mod-name">Hub Produtividade</div>
        <div class="lp-mod-desc">Ranking de técnicos, SLA e relatórios Telegram</div>
        <div class="lp-mod-badge">Ativo</div>
      </div>
      <div class="lp-mod">
        <div class="lp-mod-icon">&#128202;</div>
        <div class="lp-mod-name">Hub Gerencial</div>
        <div class="lp-mod-desc">Dashboards financeiro e comercial para diretoria</div>
        <div class="lp-mod-badge">Ativo</div>
      </div>
      <div class="lp-mod">
        <div class="lp-mod-icon">&#129309;</div>
        <div class="lp-mod-name">Hub Retencao</div>
        <div class="lp-mod-desc">Atendimento de cancelamentos e reconquista</div>
        <div class="lp-mod-badge novo">Novo</div>
      </div>
    </div>
  </div>

  <!-- DIREITA: formulário -->
  <div class="lp-right">
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <i class="fas fa-chart-network"></i>
                </div>
                <div class="login-title">Hub Gerencial</div>
                <div class="login-subtitle">GSG Intelligence</div>
            </div>

            {% if error %}
            <div class="error-msg">
                <i class="fas fa-exclamation-circle"></i>
                Usuário ou senha inválidos. Tente novamente.
            </div>
            {% endif %}

            <form action="/auth/login" method="POST">
                <div class="form-group">
                    <label>Usuário</label>
                    <div class="input-wrap">
                        <i class="fas fa-user"></i>
                        <input type="text" name="username" class="form-control" placeholder="Digite seu login" required autofocus>
                    </div>
                </div>
                <div class="form-group">
                    <label>Senha</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock"></i>
                        <input type="password" name="password" class="form-control" placeholder="Digite sua senha" required>
                    </div>
                </div>
                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt" style="margin-right:8px;"></i> ENTRAR
                </button>
            </form>

            <div class="login-footer">
                <span>&copy; 2026 GSG IaTechHub — Todos os direitos reservados</span>
            </div>
        </div>
    </div>
  </div>
</body>
</html>
